# ==============================================================================
# AI Document Understanding Platform - Environment Configuration Template
# Copy this file to '.env' and fill in your actual environment values.
# NEVER commit the active '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Flask Application Security Settings
# ------------------------------------------------------------------------------
SECRET_KEY=change-to-a-secure-random-32-byte-hex-string-for-production
SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Database Configuration (MySQL Primary Engine)
# If MySQL is not reachable, the system automatically falls back to SQLite.
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=intelligent_ocr
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# ------------------------------------------------------------------------------
# Default Initial Platform Administrator (Seeded on first initialization)
# ------------------------------------------------------------------------------
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_EMAIL=admin@docintel.io
DEFAULT_ADMIN_PASSWORD=Admin@123456

# ------------------------------------------------------------------------------
# AI & LLM Service Keys (Optional)
# If left blank, local OCR (PaddleOCR/PyMuPDF) and spaCy NER run offline.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ------------------------------------------------------------------------------
# Server Port Configuration
# ------------------------------------------------------------------------------
FLASK_PORT=5000
FASTAPI_PORT=8000
