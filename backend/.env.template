# Local environment variables template for the backend
# Copy this file to backend/.env and fill in secrets. DO NOT commit your real .env to source control.

# Database Configuration
DATABASE_URL=sqlite:///./document_ai.db

# API Configuration
API_V1_STR=/api/v1
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# File Upload Configuration
MAX_UPLOAD_SIZE=16777216
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# AI Model / OCR / LLM Configuration
DEVICE=cpu
CACHE_DIR=./models_cache
CLASSIFICATION_MODEL=microsoft/layoutlmv3-base
OCR_ENGINE=paddle
NER_MODEL=en_core_web_sm

# Gemini / Google LLM API key (replace with your key locally)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
